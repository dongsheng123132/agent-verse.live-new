# 只列代码真正读取的环境变量（grep process.env 对照过）。NODE_ENV 由 Next.js 自己设置，不要写在这里。

# 必填：Postgres 连接串（Neon 例：postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require）
DATABASE_URL=postgresql://user:pass@your-db-host.neon.tech/dbname?sslmode=require

# 收款地址，Monad 和 Base 共用一个；不设就用 lib/x402-flow.ts 里的默认地址
# PAY_TO_ADDRESS=0x...
# Coinbase CDP 密钥 ID：Base 主网的结算服务（facilitator）用它签名请求，主网要和 SECRET 一起设，不设就不带认证
# CDP_API_KEY_ID=
# Coinbase CDP 密钥 Secret：和 CDP_API_KEY_ID 配对，只在主网模式下用
# CDP_API_KEY_SECRET=
# Monad 结算服务地址，默认 https://x402-facilitator.molandak.org
# MONAD_FACILITATOR_URL=
# Base Sepolia 测试网结算服务地址（仅测试网模式用），默认 https://x402.org/facilitator
# BASE_SEPOLIA_FACILITATOR_URL=
# 设成 testnet 就切到 Monad 测试网 + Base Sepolia，其它值或不设都是主网
# X402_NETWORK_MODE=
# 设成 1 才启用开发用的假结算服务（只在非生产、测试网模式下生效，生产构建里根本没有这段代码）
# X402_FACILITATOR_MOCK=
# 管理接口 GET /api/admin/stats 的口令，不设就一律 401
# ADMIN_KEY=
# 服务端出网代理（探测服务网址时用），也认小写 https_proxy / http_proxy
# HTTPS_PROXY=
# 服务端出网代理的 http 版本，HTTPS_PROXY 没设时才看它
# HTTP_PROXY=

# 以下只给本地开发脚本用（scripts/*.mjs），线上不用
# 本地 PGlite 数据库端口，默认 5433（npm run db:local / dev:local / e2e 共用）
# LOCAL_DB_PORT=
# 本地开发服务器端口，默认 3005（npm run dev:local / taste）
# LOCAL_APP_PORT=
# db:local 同步地图时读取的公开接口，默认 https://www.agent-verse.live/api/grid
# GRID_SOURCE_URL=
# e2e 脚本访问的本地网址，默认 http://localhost:3005，只允许 localhost
# E2E_BASE_URL=
# e2e 强制使用的单格 x 坐标（和 E2E_CELL_Y 一起设）
# E2E_CELL_X=
# e2e 强制使用的单格 y 坐标（和 E2E_CELL_X 一起设）
# E2E_CELL_Y=
# e2e 截图和提示词的输出目录，默认系统临时目录下的 av-ai-purchase-<时间>
# E2E_OUT_DIR=
# e2e 用的 playwright 包所在目录，不设就按默认位置找
# PLAYWRIGHT_DIR=
